# OpenAI-compatible API key (required)
OPENAI_API_KEY=sk-...

# API base URL (optional, defaults to https://api.openai.com/v1)
# For OpenRouter: https://openrouter.ai/api/v1
# API_BASE=https://openrouter.ai/api/v1

# Model (optional, defaults to xiaomi/mimo-v2.5)
MODEL_ID=xiaomi/mimo-v2.5
# MODEL_ID=deepseek/deepseek-v4-flash-0731

# Server port (optional, defaults to 3000)
PORT=3000

# Widget host port (optional, defaults to 3001)
# WIDGET_PORT=3001

# Widget origin told to the browser (optional, defaults to http://localhost:<WIDGET_PORT>)
# WIDGET_ORIGIN=http://localhost:3001
